# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
#   For a library or package, you might want to ignore these files since the Python version is
#   usually managed by the tool (like tox) or the user.
# .python-version

# pipenv
#   According to pypa/pipenv#1191, it is recommended to not check in Pipfile.lock if it is a library.
#   For an application, you should check it in.
# Pipfile.lock

# poetry
#   Similar to Pipfile.lock, it is generally recommended to check poetry.lock in for applications.
# poetry.lock

# pdm
#   Similar to Pipfile.lock, it is generally recommended to check pdm.lock in for applications.
# .pdm-python
# .pdm-build/

# PEP 582; used by e.g. github.com/pypa/pyflow
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

